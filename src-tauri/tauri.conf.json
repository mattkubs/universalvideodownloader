{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Video Downloader",
  "version": "2.0.0",
  "identifier": "work.kubs.universalvideodownloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Universal Video Downloader",
        "width": 760,
        "height": 780,
        "minWidth": 520,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
